<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard form view -->
    <record id="view_report_analyzer_wizard_form" model="ir.ui.view">
        <field name="name">report.analyzer.wizard.form</field>
        <field name="model">report.analyzer.wizard</field>
        <field name="arch" type="xml">
            <form string="Analyze Report Views">
                <group>
                    <field name="report_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_run"
                            string="Download Analysis"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Act window that opens the wizard (used by the server action) -->
    <record id="action_report_analyzer_wizard" model="ir.actions.act_window">
        <field name="name">Analyze Report Views</field>
        <field name="res_model">report.analyzer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
